<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug only: the local dev server (docker compose, port 8001) over plain HTTP, reached from the
         emulator through `adb reverse tcp:8001 tcp:8001` (127.0.0.1) or the emulator host alias 10.0.2.2. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
